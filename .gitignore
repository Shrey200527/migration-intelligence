
# Python
__pycache__/
*.py[cod]
*.pyd
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Jupyter
.ipynb_checkpoints/

# IDE and operating system
.vscode/
.idea/
.DS_Store
Thumbs.db

# Raw and processed datasets
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
# Synthetic test datasets
data/test/*.csv

# Model checkpoints and generated artifacts
*.pt
*.pth
*.ckpt
*.onnx
artifacts/*
!artifacts/.gitkeep
# Allow only DVC pointer metadata; generated pipeline outputs remain ignored.
!data/raw/*.dvc
!data/processed/*.dvc
!artifacts/pipeline/
artifacts/pipeline/**
!artifacts/pipeline/**/
!artifacts/pipeline/**/*.dvc

# Logs and temporary files
*.log
logs/
tmp/
temp/

# Test and coverage output
.pytest_cache/
.coverage
htmlcov/

# Local databases and experiment outputs
mlruns/
mlartifacts/
airflow.db

# Incidental PowerShell module-analysis cache created in this workspace
/Microsoft/Windows/PowerShell/ModuleAnalysisCache
